# Server-only. When set, every write route requires a matching `x-shield-secret` header (401 otherwise).
# Unset (local dev): writes are open and the UI says so. Never prefix with NEXT_PUBLIC_.
SHIELD_API_SECRET=

# Set automatically when a Vercel KV store is connected. Unset: in-memory store (resets on restart).
KV_REST_API_URL=
KV_REST_API_TOKEN=
